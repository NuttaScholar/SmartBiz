# Copy this file to .env.production before building the frontend.
# Do not add server secrets here: every VITE_* value is embedded in the browser bundle.

# Main-domain Storefront and the Admin/API Gateway subdomain.
VITE_WEB_SHOP=https://example.com
VITE_API_GATEWAY_URL=https://app.example.com

# Axios uses VITE_API_GATEWAY_URL for /api/* routes.
# Media/MinIO URLs must be returned by the backend, not configured in Frontend.
