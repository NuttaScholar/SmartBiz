# Copy this file to .env.production before building the frontend.
# Do not add server secrets here: every VITE_* value is embedded in the browser bundle.

# Public origin used when generating customer Storefront links.
# When the admin app and Storefront share the same NGINX host, use the same origin.
VITE_WEB_SHOP=https://app.example.com

# API URLs are intentionally omitted. Axios uses same-origin /api/* routes,
# which NGINX forwards to the private application services.
# Media/MinIO URLs must be returned by the backend, not configured in Frontend.
