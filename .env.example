# Copy this file to .env and replace every change-me value before starting.

# Docker images
MONGO_VERSION=8.0.5

# Local virtual hosts. Storefront uses the main domain; Admin/API and MinIO use subdomains.
STOREFRONT_DOMAIN=localhost
ADMIN_DOMAIN=app.localhost
MEDIA_DOMAIN=media.localhost

# Public web origins allowed by the backend CORS configuration.
VITE_WEB_BACKEND=http://app.localhost
VITE_WEB_SHOP=http://localhost

# Authentication secrets. Generate long, independent random values.
SECRET=change-me-with-a-long-random-jwt-secret
SERVICE_AUTH_SECRET=change-me-with-an-independent-random-secret-at-least-32-characters

# MinIO
# Transitional endpoint used by current backend images for both SDK access and URLs.
# Split this into internal MINIO_ENDPOINT and public MINIO_PUBLIC_URL in the services
# before removing the direct port and using MEDIA_DOMAIN exclusively.
MINIO_ENDPOINT=192.168.1.100
VITE_PORT_MINIO=9000
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001
MINIO_USER=change-me-minio-admin
MINIO_PASSWORD=change-me-with-a-strong-minio-password

# Mongo Express is published on 127.0.0.1 only.
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=change-me-admin
MONGO_EXPRESS_PASSWORD=change-me-with-a-strong-admin-password

# Application behavior
ORDER_TTL_SECONDS=2592000
LOG_AUDIT_RETENTION_DAYS=365
