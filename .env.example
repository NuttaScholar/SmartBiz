# Environment reference for the root Docker Compose (VPS/HTTPS).
# Copy to .env and replace all placeholders, or generate .env.vps with:
# node deploy/create-env.mjs example.com admin@example.com
# See deploy/README.md for existing database migration and local Docker testing.
COMPOSE_PROJECT_NAME=smartbiz

# Docker images
MONGO_VERSION=8.0.5

# Public hostnames (no scheme or port). Caddy manages HTTPS certificates.
STOREFRONT_DOMAIN=example.com
ADMIN_DOMAIN=app.example.com
MEDIA_DOMAIN=media.example.com
ACME_EMAIL=admin@example.com

# Public web origins allowed by the backend CORS configuration.
VITE_WEB_BACKEND=https://app.example.com
VITE_WEB_SHOP=https://example.com
VITE_API_GATEWAY_URL=https://app.example.com

# MongoDB administrator credentials. Existing volumes require their current credentials.
MONGO_ROOT_USER=smartbiz_root
MONGO_ROOT_PASSWORD=GENERATE_A_RANDOM_SECRET

# Independent application passwords: exactly 64 hexadecimal characters each.
# The initializer rejects these placeholders. Use the generator above for real values.
MONGO_ACCOUNT_PASSWORD=GENERATE_64_HEX_CHARACTERS
MONGO_LOGIN_PASSWORD=GENERATE_64_HEX_CHARACTERS
MONGO_STOCK_PASSWORD=GENERATE_64_HEX_CHARACTERS
MONGO_BILL_PASSWORD=GENERATE_64_HEX_CHARACTERS
MONGO_STOREFRONT_PASSWORD=GENERATE_64_HEX_CHARACTERS

# Authentication secrets. Generate long, independent random values.
SECRET=change-me-with-a-long-random-jwt-secret
SERVICE_AUTH_SECRET=change-me-with-an-independent-random-secret-at-least-32-characters

# MinIO: Compose uses minio:9000 internally and https://${MEDIA_DOMAIN} publicly.
MINIO_CONSOLE_PORT=9001
MINIO_USER=change-me-minio-admin
MINIO_PASSWORD=change-me-with-a-strong-minio-password

# Mongo Express is published on 127.0.0.1 only.
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=change-me-admin
MONGO_EXPRESS_PASSWORD=change-me-with-a-strong-admin-password

# Application behavior
ORDER_TTL_SECONDS=2592000
LOG_AUDIT_RETENTION_DAYS=365
