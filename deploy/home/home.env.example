# Generate .env.home: npm run setup:home-env -- 192.168.1.50
# Use the Docker host's LAN IP, not a container IP or localhost.
HOME_HOST=192.168.1.50
HOME_BIND_IP=0.0.0.0
HOME_ADMIN_PORT=8080
HOME_SHOP_PORT=8082
HOME_MEDIA_PORT=9000

# Vite expands these when running npm run build:home.
VITE_WEB_SHOP=http://${HOME_HOST}:${HOME_SHOP_PORT}
VITE_API_GATEWAY_URL=http://${HOME_HOST}:${HOME_ADMIN_PORT}

# Keep these three MongoDB settings in sync. Home uses independent volumes.
MONGO_VERSION=8.0.5
MONGO_DEPLOY_DIR=mongodb-8.0
MONGO_SHELL=mongosh
MONGO_ROOT_USER=smartbiz_home_root
MONGO_ROOT_PASSWORD=GENERATE_SECRET
MONGO_ACCOUNT_PASSWORD=GENERATE_SECRET
MONGO_LOGIN_PASSWORD=GENERATE_SECRET
MONGO_STOCK_PASSWORD=GENERATE_SECRET
MONGO_BILL_PASSWORD=GENERATE_SECRET
MONGO_STOREFRONT_PASSWORD=GENERATE_SECRET
SECRET=GENERATE_SECRET
SERVICE_AUTH_SECRET=GENERATE_SECRET
MINIO_USER=smartbiz_home_storage
MINIO_PASSWORD=GENERATE_SECRET
MONGO_EXPRESS_USERNAME=smartbiz_home_admin
MONGO_EXPRESS_PASSWORD=GENERATE_SECRET
MONGO_EXPRESS_PORT=18081
MINIO_CONSOLE_PORT=19001
ORDER_TTL_SECONDS=2592000
LOG_AUDIT_RETENTION_DAYS=365
