# Reference only. Generate independent secrets with: node deploy/create-env.mjs example.com admin@example.com
# The generated .env.vps is ignored by Git. Never use these placeholder passwords.
COMPOSE_PROJECT_NAME=smartbiz
STOREFRONT_DOMAIN=example.com
ADMIN_DOMAIN=app.example.com
MEDIA_DOMAIN=media.example.com
ACME_EMAIL=admin@example.com
VITE_WEB_BACKEND=https://app.example.com
VITE_WEB_SHOP=https://example.com
VITE_API_GATEWAY_URL=https://app.example.com
MONGO_VERSION=8.0.5
MONGO_ROOT_USER=smartbiz_root
MONGO_ROOT_PASSWORD=GENERATE_A_RANDOM_SECRET
MONGO_ACCOUNT_PASSWORD=GENERATE_64_HEX_CHARACTERS
MONGO_LOGIN_PASSWORD=GENERATE_64_HEX_CHARACTERS
MONGO_STOCK_PASSWORD=GENERATE_64_HEX_CHARACTERS
MONGO_BILL_PASSWORD=GENERATE_64_HEX_CHARACTERS
MONGO_STOREFRONT_PASSWORD=GENERATE_64_HEX_CHARACTERS
SECRET=GENERATE_A_RANDOM_SECRET
SERVICE_AUTH_SECRET=GENERATE_AN_INDEPENDENT_RANDOM_SECRET
MINIO_USER=smartbiz_storage
MINIO_PASSWORD=GENERATE_A_RANDOM_SECRET
MINIO_CONSOLE_PORT=9001
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=smartbiz_admin
MONGO_EXPRESS_PASSWORD=GENERATE_A_RANDOM_SECRET
ORDER_TTL_SECONDS=2592000
LOG_AUDIT_RETENTION_DAYS=365
